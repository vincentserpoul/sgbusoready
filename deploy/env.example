# Copy to ~/sgbr/env on the VM and `chmod 600` it. Read by
# crates/sgbr-worker/src/config.rs::Config::from_env — see that file for the
# authoritative list. Real secrets — never commit the filled-in version.

# --- secrets ---
# LTA DataMall AccountKey (https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html).
LTA_API_ACCOUNT_KEY=replace-with-your-lta-datamall-account-key
# Admin API bearer for the invite/device endpoints. Generate with:
#   openssl rand -hex 24
SGBR_ADMIN_TOKEN=replace-with-a-random-hex-token

# --- non-secret runtime config (kept in the same file per the deploy quadlet) ---
# Must be 0.0.0.0:<port> in-container — 127.0.0.1 (the config default) is
# unreachable from cloudflared's side of the sgbr network.
SGBR_BIND=0.0.0.0:8080
# Must match the quadlet's Volume= container-side mount point.
SGBR_DATA_DIR=/data
# Optional; defaults to 15 if unset.
# SGBR_POLL_SECS=15
